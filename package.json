{
  "name": "cauprophet",
  "version": "0.1.0",
  "description": "An AI agent for causal inference and discovery, with a terminal and web UI.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "cauprophet": "src/cli/index.tsx",
    "causalclaw": "src/cli/index.tsx"
  },
  "main": "src/cli/index.tsx",
  "files": [
    "src/",
    "server/",
    "web/dist/",
    "templates/",
    "python/",
    "tsconfig.json"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "postinstall": "bun install --cwd web --frozen-lockfile",
    "build": "bun run --cwd web build",
    "start": "bun run src/cli/index.tsx",
    "dev": "bun server/dev.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/bun": "latest",
    "@types/react": "^19.2.14"
  },
  "peerDependencies": {
    "typescript": "^6"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^17.0.5",
    "marked-terminal": "^7.3.0",
    "openai": "^6.33.0",
    "picocolors": "^1.1.1",
    "react": "^19.2.4",
    "zod": "^4.3.6"
  }
}
